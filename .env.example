# ZenithStore Environment Configuration

# Server Port & Mode
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173

# ========================================================
# DATABASE CONFIGURATION (Supports SQLite, PostgreSQL, MySQL)
# ========================================================
# 1. SQLite (Default - Zero setup, works instantly locally):
DATABASE_URL="file:./dev.db"

# 2. PostgreSQL (e.g. Local Docker, Supabase, Neon, AWS RDS):
# In prisma/schema.prisma: change provider = "postgresql"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ecommerce?schema=public"

# 3. MySQL (e.g. Local MySQL, XAMPP, PlanetScale, AWS RDS):
# In prisma/schema.prisma: change provider = "mysql"
# DATABASE_URL="mysql://root:password@localhost:3306/ecommerce"

# 4. MongoDB (via MongoDB Atlas or local mongod):
# In prisma/schema.prisma: change provider = "mongodb"
# DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority"

